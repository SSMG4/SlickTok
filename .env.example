# Port the Node process listens on (Cloudflare Tunnel points here)
PORT=3000

# Public origin of the site, used to build absolute URLs
PUBLIC_URL=https://slicktok.ssmg4.dpdns.org

# Path to the yt-dlp binary. Leave as "yt-dlp" if it's on PATH.
YTDLP_PATH=yt-dlp

# Shared secret configured on the GitHub webhook (Settings > Webhooks).
# Generate one with: openssl rand -hex 32
DEPLOY_WEBHOOK_SECRET=change-me

# Branch that triggers an auto-deploy on push
DEPLOY_BRANCH=main

# Rate limits (per IP, no accounts)
RATE_LIMIT_PER_HOUR=50
RATE_LIMIT_PER_DAY=1000
